<?xml version="1.0" encoding="utf-8"?>
<!-- Two stacked bank cards. Everything stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back card (tilted, translucent) -->
    <group
        android:pivotX="54"
        android:pivotY="50"
        android:rotation="-12">
        <path
            android:fillColor="#59FFFFFF"
            android:pathData="M36,33H72A5,5 0,0 1,77 38V60A5,5 0,0 1,72 65H36A5,5 0,0 1,31 60V38A5,5 0,0 1,36 33Z" />
    </group>

    <!-- Front card with cyan to blue gradient -->
    <path android:pathData="M33,41H75A6,6 0,0 1,81 47V67A6,6 0,0 1,75 73H33A6,6 0,0 1,27 67V47A6,6 0,0 1,33 41Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="41"
                android:endX="81"
                android:endY="73">
                <item android:offset="0" android:color="#FF22D3EE" />
                <item android:offset="1" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gold chip -->
    <path
        android:fillColor="#FFFDE68A"
        android:pathData="M35,49H44A2,2 0,0 1,46 51V57A2,2 0,0 1,44 59H35A2,2 0,0 1,33 57V51A2,2 0,0 1,35 49Z" />

    <!-- Card number lines -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M35,66H48M53,66H60" />

    <!-- Overlapping circles logo -->
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M70,52m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
    <path
        android:fillColor="#8CFFFFFF"
        android:pathData="M74.5,52m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
</vector>
